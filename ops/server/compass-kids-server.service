[Unit]
Description=Compass Kids API server
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/compass-kids
EnvironmentFile=/etc/compass-kids/server.env
ExecStart=/home/ubuntu/.local/node22/bin/node /home/ubuntu/compass-kids/vapp/server.js
Restart=always
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/compass-kids/log
StandardOutput=journal
StandardError=journal
SyslogIdentifier=compass-kids-server

[Install]
WantedBy=multi-user.target
